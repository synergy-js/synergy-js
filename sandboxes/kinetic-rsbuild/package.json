{
	"name": "kinetic-rsbuild",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wireit"
	},
	"wireit": {
		"dev": {
			"command": "rs dev",
			"clean": "if-file-deleted",
			"service": true,
			"dependencies": [
				"../../packages/prism:build",
				"../../packages/kinetic:build",
				"../../packages/rsbuild-plugin-kinetic:build"
			],
			"files": [
				"src/**/*.ts"
			],
			"readyWhen": {
				"lineMatches": "Rsbuild v2.3.4"
			}
		}
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"happy-dom": "^21.0.4",
		"rstack": "catalog:",
		"typescript": "catalog:",
		"wireit": "catalog:"
	}
}
