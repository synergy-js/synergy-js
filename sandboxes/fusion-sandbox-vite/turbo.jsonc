{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "sandbox-vite-dev-bun": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "src/**"],
      "dependsOn": [],
    },
    "sandbox-vite-build": {
      "cache": false,
    },
    "sandbox-vite-preview": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**"],
      "dependsOn": ["sandbox-vite-build"],
    },
  },
}
