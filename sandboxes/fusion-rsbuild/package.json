{
	"name": "fusion-sandbox-rsbuild",
	"version": "0.1.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "wireit",
		"build": "wireit",
		"preview": "PORT=8888 bun dist/index.js",
		"clean:node": "rm -rf node_modules",
		"clean:dist": "rm -rf dist"
	},
	"wireit": {
		"dev": {
			"command": "rs dev",
			"dependencies": [
				"../../packages/prism:build",
				"../../packages/kinetic:build",
				"../../packages/rsbuild-plugin-kinetic:build"
			]
		},
		"build": {
			"clean": "if-file-deleted",
			"command": "rs lib",
			"files": [
				"src/**/*.ts"
			],
			"output": [
				"dist/**"
			]
		}
	},
	"dependencies": {
		"@synergy-js/fusion": "workspace:*",
		"@synergy-js/kinetic": "workspace:*",
		"@synergy-js/rsbuild-plugin-kinetic": "workspace:*",
		"@synergy-js/prism": "workspace:*"
	},
	"devDependencies": {
		"@rsbuild/core": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"rstack": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"wireit": "catalog:"
	}
}
