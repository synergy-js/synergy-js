{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": [
		"//"
	],
	"tasks": {
		"sandbox-rsbuild-dev-bun": {
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"src/**"
			],
			"dependsOn": []
		},
		"sandbox-rsbuild-dev-node": {
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"src/**"
			],
			"dependsOn": []
		},
		"sandbox-rsbuild-test": {
			"cache": false
		},
		"sandbox-rsbuild-build": {
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$"
			],
			"outputs": [
				"dist/**"
			],
			"dependsOn": [
				"^fusion-build"
			]
		},
		"sandbox-rsbuild-preview": {
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$"
			],
			"outputs": [
				"dist/**"
			],
			"dependsOn": [
				"sandbox-rsbuild-build"
			]
		}
	}
}
