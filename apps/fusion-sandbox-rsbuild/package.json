		"@rsbuild/plugin-babel": "^2.1.0",
		"@rsbuild/plugin-tailwindcss": "^2.0.3",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"tailwindcss": "catalog:",
		"@rsbuild/plugin-solid": "^1.2.2"
	},
	"peerDependencies": {
		"solid-js": "catalog:"
	}
