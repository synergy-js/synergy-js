{
	"name": "@synergy-js/prism",
	"version": "0.0.1",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "rs lib",
			"clean": "if-file-deleted",
			"dependencies": [
			],
			"files": [
				"src/**/*.ts"
			],
			"output": [
				"dist/**"
			]
		}
	},
	"dependencies": {
		"csstype": "^3.2.3"
	},
	"devDependencies": {
		"@rsdoctor/rspack-plugin": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"rstack": "catalog:",
		"typescript": "catalog:",
		"wireit": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	}
}
