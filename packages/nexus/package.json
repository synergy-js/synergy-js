{
	"name": "@synergy-js/nexus",
	"version": "1.0.1",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/synergy-js/synergy-js.git",
		"directory": "packages/nexus"
	},
	"type": "module",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"clean": "if-file-deleted",
			"command": "rs lib",
			"files": [
				"src/**/*.ts"
			],
			"output": [
				"dist/**"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/rpc-client/index.d.ts",
			"import": "./dist/rpc-client/index.js"
		},
		"./adapters": {
			"types": "./dist/adapters/index.d.ts",
			"import": "./dist/adapters/index.js"
		}
	},
	"dependencies": {
		"@synergy-js/infusion": "workspace:*"
	},
	"devDependencies": {
		"@rsdoctor/rspack-plugin": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"rstack": "catalog:",
		"typescript": "catalog:",
		"wireit": "catalog:"
	}
}
