// scribe
{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": [
		"//"
	],
	"tags": [
		"lib"
	],
	"tasks": {
		"scribe-build": {
			"cache": true,
			"tags": [
				"public",
				"lib"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"src/"
			],
			"outputs": [
				"dist/"
			],
			"dependsOn": []
		},
		"scribe-test": {
			"cache": false,
			"persistent": true,
			"dependsOn": []
		},
		"scribe-sandbox": {
			"cache": false,
			"persistent": true,
			"dependsOn": []
		}
	}
}
