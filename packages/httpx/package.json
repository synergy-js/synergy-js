{
	"name": "@synergy-js/httpx",
	"version": "0.1.0-beta.1",
	"license": "MIT",
	"description": "A better way to fetch http data",
	"repository": {
		"type": "git",
		"url": "https://github.com/synergy-js/synergy-js.git",
		"directory": "packages/httpx"
	},
	"type": "module",
	"keywords": [
		"http",
		"fetch",
		"interceptors",
		"zero dependency"
	],
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "wireit",
		"test": "wireit"
	},
	"wireit": {
		"build": {
			"clean": "if-file-deleted",
			"command": "rs lib",
			"files": [
				"src/**/*.ts"
			],
			"output": [
				"dist/**"
			]
		},
		"test": {}
	},
	"devDependencies": {
		"@rsdoctor/rspack-plugin": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"rstack": "catalog:",
		"typescript": "catalog:",
		"wireit": "catalog:"
	}
}
