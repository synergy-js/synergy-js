{
	"name": "@synergy-js/verdict",
	"version": "0.1.0-beta.0",
	"description": "Rust-inspired `Ok` / `Err` error handling and ergonomic escape hatches",
	"keywords": [
		"Javascript error handling",
		"error handling",
		"rust",
		"zero dependency",
		"match"
	],
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"command": "rs lib",
			"clean": "if-file-deleted",
			"files": [
				"src/**/*.ts"
			],
			"output": [
				"dist/**"
			]
		}
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/synergy-js/synergy-js.git",
		"directory": "packages/verdict"
	},
	"funding": {
		"type": "ko-fi",
		"url": "https://ko-fi.com/mpaynesecurity"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"devDependencies": {
		"@rsdoctor/rspack-plugin": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"rstack": "catalog:",
		"typescript": "catalog:",
		"wireit": "catalog:"
	}
}
