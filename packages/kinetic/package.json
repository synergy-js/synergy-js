{
	"name": "@synergy-js/kinetic",
	"version": "0.1.0-beta.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/synergy-js/synergy-js.git",
		"directory": "packages/kinetic"
	},
	"type": "module",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "wireit",
		"test": "rs test"
	},
	"wireit": {
		"build": {
			"command": "rs lib",
			"clean": "if-file-deleted",
			"dependencies": [],
			"files": [
				"src/**/*.ts",
				"src/**/*.tsx"
			],
			"output": [
				"dist/**"
			]
		}
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./web": {
			"import": "./dist/web/index.js",
			"types": "./dist/web/index.d.ts"
		},
		"./router": {
			"import": "./dist/router/index.js",
			"types": "./dist/router/index.d.ts"
		},
		"./signals": {
			"import": "./dist/signals/index.js",
			"types": "./dist/signals/index.d.ts"
		},
		"./testing": {
			"import": "./dist/testing/index.js",
			"types": "./dist/testing/index.d.ts"
		},
		"./jsx-runtime": {
			"types": "./dist/web/jsx-runtime.d.ts",
			"import": "./dist/web/jsx-runtime.js"
		},
		"./jsx-dev-runtime": {
			"types": "./dist/web/jsx-dev-runtime.d.ts",
			"import": "./dist/web/jsx-dev-runtime.js"
		}
	},
	"devDependencies": {
		"@synergy-js/rsbuild-plugin-kinetic": "workspace:*",
		"@rstest/adapter-rsbuild": "^0.12.6",
		"@rsdoctor/rspack-plugin": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"happy-dom": "catalog:",
		"rstack": "catalog:",
		"typescript": "catalog:",
		"wireit": "catalog:"
	}
}
