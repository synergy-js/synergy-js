{
	"name": "@synergy-js/infusion",
	"version": "0.1.0-beta.0",
	"description": "A lightweight, type-safe, and universal dependency injection provider for TypeScript and JavaScript",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/synergy-js/synergy-js.git",
		"directory": "packages/infusion"
	},
	"keywords": [
		"zero dependency",
		"typescript",
		"dependency injection"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "wireit"
	},
	"wireit": {
		"build": {
			"clean": "if-file-deleted",
			"command": "rs lib",
			"files": [
				"src/**/*.ts"
			],
			"output": [
				"dist/**"
			]
		}
	},
	"devDependencies": {
		"@rsdoctor/rspack-plugin": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"rstack": "catalog:",
		"typescript": "catalog:",
		"wireit": "catalog:"
	}
}
