{
	"name": "@synergy-js/fusion",
	"version": "0.1.0-beta.0",
	"type": "module",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "wireit",
		"test": "rstest run"
	},
	"wireit": {
		"build": {
			"clean": "if-file-deleted",
			"command": "rs lib",
			"files": [
				"src/**/*.ts"
			],
			"output": [
				"dist/**"
			],
			"dependencies": [
				"../verdict:build",
				"../scribe:build"
			]
		}
	},
	"dependencies": {
		"@synergy-js/scribe": "workspace:*",
		"@synergy-js/verdict": "workspace:*",
		"magic-string": "catalog:",
		"oxc-parser": "catalog:"
	},
	"devDependencies": {
		"@rsbuild/core": "catalog:",
		"@rsdoctor/rspack-plugin": "catalog:",
		"@rstest/adapter-rsbuild": "catalog:",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"rstack": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wireit": "catalog:"
	},
	"exports": {
		"./rsbuild": {
			"types": "./dist/rsbuild/index.d.ts",
			"import": "./dist/rsbuild/index.js"
		},
		"./vite": {
			"types": "./dist/vite/index.d.ts",
			"import": "./dist/vite/index.js"
		}
	}
}
