{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": [
		"//"
	],
	"tags": [
		"lib"
	],
	"tasks": {
		"hookr-build": {
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"src"
			],
			"outputs": [
				"dist"
			]
		},
		"hookr-test": {
			"cache": false,
			"persistent": true,
			"dependsOn": []
		}
	}
}
